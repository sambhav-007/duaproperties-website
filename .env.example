# MongoDB Atlas (M0 free tier)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<dbName>?retryWrites=true&w=majority

# JWT secret for admin session signing
JWT_SECRET=replace-with-a-long-random-secret

# Admin credentials
ADMIN_EMAIL=admin@example.com
# Preferred: use hashed password
ADMIN_PASSWORD_HASH=$2a$10$replace_with_bcrypt_hash
# Optional fallback if hash is not used (not recommended)
# ADMIN_PASSWORD=your-plain-password

# Cloudinary unsigned upload (free tier)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
